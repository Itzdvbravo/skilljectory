{
  "expo": {
    "name": "SkillExchange",
    "slug": "campus-skill-exchange",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.skillexchange.campus",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19"
      },
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "https://skilljectory-api-inuv.vercel.app"
    }
  }
}
