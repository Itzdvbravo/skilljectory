# Environment Variables for Campus Skill Exchange Platform

# Backend API Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# Database
# Replace postgres:YOUR_PASSWORD with your actual local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:piyus@localhost:5432/campus_skill_exchange?schema=public"

# Redis (Optional, BullMQ / Cache)
REDIS_URL="redis://localhost:6379"

# JWT Secrets
JWT_ACCESS_SECRET="dev_access_secret_skill_exchange_super_secure_key_123"
JWT_REFRESH_SECRET="dev_refresh_secret_skill_exchange_super_secure_key_456"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Credit Economy Configuration (Section 5.2)
SIGNUP_BONUS_CREDITS=3
FREE_ANNOUNCEMENT_COOLDOWN_DAYS=4
FREE_ANNOUNCEMENTS_MAX=4
ATTENDANCE_CONFIRMATION_WINDOW_HOURS=48
MONTHLY_REFILL_CREDITS=2
BLOG_UNLOCK_MIN_HOURS=15
BLOG_UNLOCK_MIN_BALANCE=10

# S3 / Object Storage (Local mock / compatible)
STORAGE_BUCKET="skill-exchange-uploads"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
