{
  "name": "campus-skill-exchange-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Campus-restricted platform for student skill exchange with time-credit economy",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces build --if-present",
    "test": "npm run --workspaces test --if-present",
    "test:credits": "npm run --workspace=services/api test:credits",
    "api:dev": "npm run --workspace=services/api dev",
    "mobile:start": "npm run --workspace=apps/mobile start",
    "mobile:build:apk": "npm run --workspace=apps/mobile build:apk"
  },
  "keywords": [
    "campus",
    "skill-exchange",
    "credit-economy",
    "monorepo",
    "react-native",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react-native": "^0.74.5",
    "react-native-safe-area-context": "^4.10.5",
    "typescript": "5.9.3"
  }
}
